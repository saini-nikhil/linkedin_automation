NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_automation
# Alternative individual vars (used when DATABASE_URL is empty):
# DB_HOST=
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=
# DB_SSL=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/linkedin/oauth/callback
# Pinned LinkedIn API version (YYYYMM). Bump every ~6 months; sunset versions return 426.
LINKEDIN_API_VERSION=202608
APP_BASE_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
